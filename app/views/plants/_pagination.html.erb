<% if @page_count > 1 %>
  <% filters = { q: @query.presence, family_id: @family_id }.compact %>
  <nav class="d-flex flex-wrap align-items-center gap-3 mt-4" aria-label="Catalog pages">
    <% if @page > 1 %>
      <%= link_to "Previous", plants_path(filters.merge(page: @page - 1)), class: "btn btn-outline-success" %>
    <% end %>
    <span>Page <%= @page %> of <%= @page_count %></span>
    <% if @page < @page_count %>
      <%= link_to "Next", plants_path(filters.merge(page: @page + 1)), class: "btn btn-outline-success" %>
    <% end %>
  </nav>
<% end %>
